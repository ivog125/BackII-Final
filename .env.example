# Puerto donde escucha el servidor HTTP
PORT=8080

# Cadena de conexión a MongoDB (instancia local o Atlas)
MONGO_URL=mongodb://localhost:27017/proyecto-eventos

# Clave secreta para firmar y verificar los JWT (usar un valor largo y aleatorio en producción, nunca este)
JWT_SECRET=reemplazar_con_un_secreto_largo_y_aleatorio

# Tiempo de expiración del JWT y de la cookie de sesión (ej. 1h, 30m, 7d)
JWT_EXPIRES_IN=1h

# Entorno de ejecución: development | production
NODE_ENV=development

# Host del servidor SMTP de pruebas (ej. sandbox de Mailtrap)
MAIL_HOST=sandbox.smtp.mailtrap.io

# Puerto del servidor SMTP
MAIL_PORT=2525

# Usuario para autenticarse contra el SMTP
MAIL_USER=reemplazar_con_usuario_smtp

# Contraseña del usuario SMTP
MAIL_PASS=reemplazar_con_password_smtp

# Dirección que figura como remitente de los emails de confirmación
MAIL_FROM=no-reply@proyecto-eventos.com
