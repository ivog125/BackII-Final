          "name": "Inscribirse (User1) -> guarda ticketId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/events/{{eventId}}/tickets", "host": ["{{baseUrl}}"], "path": ["api", "events", "{{eventId}}", "tickets"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('reservationCode con formato EVT-XXXXXX', function () { pm.expect(json.payload.reservationCode).to.match(/^EVT-[A-Z0-9]{6}$/); });",
                  "pm.collectionVariables.set('ticketId', json.payload.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscripción duplicada (User1, esperado 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1\n}", "options": { "raw": { "language": "json" } } },
