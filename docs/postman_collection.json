    {
      "name": "3. Tickets",
      "item": [
        {
          "name": "Login - User1 (para inscribirse)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user1@eventos.com\",\n  \"password\": \"Password123\"\n}", "options": { "raw": { "language": "json" } } },
